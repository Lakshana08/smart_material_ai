# Local development defaults. Copy to .env and fill in real values there -
# .env is gitignored; this file is NOT, so never put real secrets here.

# SAP Destination name pointing at the S/4HANA OData services (used only when
# S4_BASE_URL below is empty - i.e. the full BTP deployment path)
S4_DESTINATION_NAME=S4HANA_MATERIAL_API

# Direct-connect mode: set this to call the S/4 system directly, bypassing
# BTP Destination/Connectivity - useful for dev/testing against a directly
# reachable system before those services are provisioned.
S4_BASE_URL=http://<s4-host-or-ip>:50000
S4_USERNAME=
S4_PASSWORD=

# Base URL this app is reachable at - used to build each A2A agent's AgentCard.url
# and report download links. Set to the real Cloud Foundry route once deployed.
APP_PUBLIC_URL=http://localhost:8000

REPORT_DOWNLOAD_TTL_SECONDS=900

# SAP AI Core - direct Foundation Model access, used by the 3 agents to parse
# free-text input and phrase natural-language summaries. Leave AI_CORE_ENABLED
# false to keep the agents on structured-JSON-only input (current default
# behavior, no AI Core needed at all).
AI_CORE_ENABLED=false
AI_CORE_MODEL_NAME=gpt-4o-mini

# These are read directly by the gen_ai_hub SDK via os.environ (NOT through
# this app's own Settings/config.py) - come from your AI Core service key.
# On Cloud Foundry, bind an AI Core service instance instead and these are
# picked up automatically via VCAP_SERVICES - no need to set them here.
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default

# If set, identifies the exact AI Core deployment to call directly (preferred
# over AI_CORE_MODEL_NAME above - skips the model_name catalog lookup).
LLM_DEPLOYMENT_ID=
